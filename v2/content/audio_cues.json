{
  "about": "صوتيات التطبيق العامة: الشعارات، ومقدمات المراحل وخواتيمها، والانتقالات، والتحذيرات، وردود الفعل، وكتالوج المؤثرات الصوتية، وربط المؤثرات بالمكونات. والنصوص بتتسجل بنفس صوت المعلق.",
  "voice": [
    {
      "group": "الشعارات والترحيب",
      "clips": [
        {
          "audio": "global/slogan_main.mp3",
          "sfx_before": "intro_jingle",
          "text_ar": "أكاديمية التحكم الكهربائي. افهمها جيدًا، ووصّلها جيدًا، واعمل بأمان."
        },
        {
          "audio": "global/slogan_short.mp3",
          "text_ar": "التحكم الكلاسيكي: علمٌ، ومهارة، وأمان."
        },
        {
          "audio": "global/welcome.mp3",
          "sfx_before": "intro_jingle",
          "text_ar": "مرحبًا بك في معمل التحكم الكلاسيكي. هنا سترى كل مكوّن من الداخل والخارج، وتفكّه وتركّبه بيدك، وتستمع إلى شرح كل قطعة فيه. ثم ستوصّل دوائر حقيقية على لوحة كهربائية، وتشغّلها وتقيسها، كأنك في الورشة تمامًا. هيا نبدأ."
        },
        {
          "audio": "global/welcome_back.mp3",
          "text_ar": "مرحبًا بعودتك. نكمل من حيث توقفنا."
        },
        {
          "audio": "global/goodbye.mp3",
          "sfx_after": "outro_sting",
          "text_ar": "شكرًا لأنك تعلمت معنا اليوم. وتذكّر: الفني الماهر هو من يفصل الكهرباء ويتأكد قبل أن يلمس. نراك في المرة القادمة."
        }
      ]
    },
    {
      "group": "مقدمات المراحل وخواتيمها",
      "clips": [
        {
          "audio": "stage/library_intro.mp3",
          "sfx_before": "stage_sting",
          "text_ar": "المرحلة الأولى: مكتبة المكونات. هنا ستتعرف على كل جهاز في لوحة التحكم: شكله، وتركيبه الداخلي، وطريقة عمله، وكيف نختاره ونختبره. المس أي قطعة لتستمع إلى شرحها."
        },
        {
          "audio": "stage/library_outro.mp3",
          "sfx_after": "success_chime",
          "text_ar": "أحسنت. لقد تعرفت على المكونات الأساسية. الخطوة التالية أن نجمعها معًا في دائرة."
        },
        {
          "audio": "stage/ladder_intro.mp3",
          "sfx_before": "stage_sting",
          "text_ar": "المرحلة الثانية: المخطط. سنرسم دائرة التحكم بالرموز القياسية، ونشغّلها، ونرى أين يسري التيار، ومتى تُفتح كل نقطة ومتى تُغلق."
        },
        {
          "audio": "stage/ladder_outro.mp3",
          "sfx_after": "success_chime",
          "text_ar": "ممتاز. المخطط يعمل بشكل صحيح. والآن ننقله إلى اللوحة الحقيقية."
        },
        {
          "audio": "stage/lab_intro.mp3",
          "sfx_before": "stage_sting",
          "text_ar": "المرحلة الثالثة: المعمل. أمامك صندوق لوحة حقيقي. ركّب المكونات على القضيب، ووصّل الأسلاك من طرف إلى طرف، واختر لون كل سلك ومقطعه. وقبل التشغيل، راجع توصيلك بجهاز القياس."
        },
        {
          "audio": "stage/lab_outro.mp3",
          "sfx_after": "success_chime",
          "text_ar": "اشتغلت اللوحة بشكل صحيح من المرة الأولى. هذا عمل فني محترف."
        },
        {
          "audio": "stage/faults_intro.mp3",
          "sfx_before": "stage_sting",
          "text_ar": "مرحلة الأعطال. في هذه اللوحة عطل مخفي. استخدم جهاز القياس المتعدد وجهاز قياس التيار بالكلّابة، وفكّر بترتيب، حتى تجده."
        },
        {
          "audio": "stage/faults_outro.mp3",
          "sfx_after": "success_chime",
          "text_ar": "وجدت العطل. التفكير المنظم هو سرّ الصيانة الناجحة."
        },
        {
          "audio": "stage/exam_intro.mp3",
          "sfx_before": "stage_sting",
          "text_ar": "مرحلة الاختبار. لا توجد مساعدة ولا حل تلقائي. خذ وقتك، وراجع قبل أن تشغّل. بالتوفيق."
        },
        {
          "audio": "stage/exam_outro_pass.mp3",
          "sfx_after": "success_fanfare",
          "text_ar": "تهانينا، لقد نجحت في الاختبار. شهادتك جاهزة."
        },
        {
          "audio": "stage/exam_outro_fail.mp3",
          "sfx_after": "soft_fail",
          "text_ar": "لم تصل هذه المرة إلى الدرجة المطلوبة. راجع الأخطاء الموجودة في التقرير، وحاول مرة أخرى. كل خطأ تتعلم منه خطوة إلى الأمام."
        }
      ]
    },
    {
      "group": "الانتقالات داخل الدرس وبين المراحل",
      "clips": [
        {
          "audio": "global/next_section.mp3",
          "sfx_before": "ui_whoosh",
          "text_ar": "ننتقل إلى الجزء التالي."
        },
        {
          "audio": "global/next_part.mp3",
          "text_ar": "القطعة التالية."
        },
        {
          "audio": "global/disassemble.mp3",
          "sfx_after": "explode_whoosh",
          "text_ar": "هيا نفكّ المكوّن، قطعة قطعة."
        },
        {
          "audio": "global/assemble.mp3",
          "sfx_after": "assemble_snap",
          "text_ar": "والآن نعيد كل قطعة إلى مكانها."
        },
        {
          "audio": "global/energize.mp3",
          "text_ar": "لنوصّل الكهرباء ونرى ما يحدث في الداخل."
        },
        {
          "audio": "global/recap.mp3",
          "text_ar": "نلخّص ما تعلمناه."
        },
        {
          "audio": "global/try_yourself.mp3",
          "text_ar": "دورك الآن. جرّب بنفسك."
        },
        {
          "audio": "global/between_stages.mp3",
          "sfx_before": "stage_sting",
          "text_ar": "انتهت هذه المرحلة. خذ استراحة قصيرة، هل أنت مستعد للمرحلة التالية؟"
        }
      ]
    },
    {
      "group": "تحذيرات الأمان",
      "clips": [
        {
          "audio": "warn/lockout.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "تحذير. قبل أن تفتح أي لوحة أو تلمس أي طرف توصيل: افصل المفتاح الرئيسي، وأقفله بقفلك الشخصي، وعلّق بطاقة التحذير، ثم تأكد من عدم وجود جهد بجهاز قياس سليم."
        },
        {
          "audio": "warn/live_terminals.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "انتبه. أطراف الدخول قد يكون عليها جهد حتى لو كان الجهاز مفصولًا."
        },
        {
          "audio": "warn/never_bypass.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "تحذير. يُمنع إلغاء أي جهاز حماية، أو رفع قيمته، أو وضع سلك مكان المصهر. هذه الحماية هي التي تنقذ الأرواح والأجهزة."
        },
        {
          "audio": "warn/ct_open.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "تحذير خطير. يُمنع فتح دائرة الملف الثانوي لمحول التيار والكابل عليه حمل. اقصر الطرفين S1 و S2 أولًا."
        },
        {
          "audio": "warn/rotating.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "انتبه للأجزاء الدوّارة. لا تقترب من العمود أو المروحة والمحرك يعمل، وأعد الواقيات إلى مكانها."
        },
        {
          "audio": "warn/meter_category.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "قبل القياس: تأكد أن المجسات في الأطراف الصحيحة، وأن فئة أمان الجهاز مناسبة للمكان الذي تقيس فيه."
        },
        {
          "audio": "warn/estop_not_routine.mp3",
          "text_ar": "مفتاح الطوارئ للطوارئ فقط، وليس بديلًا عن ضاغط الإيقاف العادي."
        },
        {
          "audio": "warn/arc.mp3",
          "sfx_before": "arc_crackle",
          "text_ar": "حرارة الشرارة الكهربائية تبلغ آلاف الدرجات. افتح الأحمال وأغلقها بالأجهزة المخصصة لذلك، وليس بفكّ الأسلاك."
        },
        {
          "audio": "warn/sim_short_circuit.mp3",
          "sfx_before": "short_circuit_bang",
          "text_ar": "قصر. هذا التوصيل أحدث قصرًا بين نقطتين عليهما جهد، ففصل القاطع. راجع آخر سلك وصّلته."
        },
        {
          "audio": "warn/sim_wrong_coil_voltage.mp3",
          "sfx_before": "coil_hum_loud",
          "text_ar": "جهد الملف غير صحيح. الكونتاكتور يطنّ ولا يستطيع الجذب. راجع جهد دائرة التحكم."
        },
        {
          "audio": "warn/sim_overload_trip.mp3",
          "sfx_before": "overload_trip",
          "text_ar": "فصل الأوفرلود. ابحث عن السبب قبل إعادة الضبط: حمل زائد، أو فقد فاز، أو ضبط خاطئ."
        },
        {
          "audio": "warn/sim_phase_loss.mp3",
          "sfx_before": "motor_strain",
          "text_ar": "فقد فاز. المحرك يطنّ ولا يستطيع الدوران، وتياره مرتفع. افصل فورًا."
        },
        {
          "audio": "warn/sim_interlock.mp3",
          "sfx_before": "error_buzz",
          "text_ar": "لا يجوز تشغيل الاتجاهين معًا. منع التداخل الكهربائي حدوث قصر بين فازين."
        },
        {
          "audio": "warn/sim_live_touch.mp3",
          "sfx_before": "error_buzz",
          "text_ar": "توقف. أنت تلمس طرفًا عليه جهد. افصل الكهرباء أولًا."
        }
      ]
    },
    {
      "group": "ردود الفعل",
      "clips": [
        {
          "audio": "fb/correct.mp3",
          "sfx_before": "success_chime",
          "text_ar": "إجابة صحيحة."
        },
        {
          "audio": "fb/correct_alt.mp3",
          "sfx_before": "success_chime",
          "text_ar": "أحسنت."
        },
        {
          "audio": "fb/wrong.mp3",
          "sfx_before": "error_buzz",
          "text_ar": "ليست هذه. فكّر مرة أخرى."
        },
        {
          "audio": "fb/step_done.mp3",
          "sfx_before": "part_select",
          "text_ar": "اكتملت هذه الخطوة."
        },
        {
          "audio": "fb/wire_ok.mp3",
          "sfx_before": "screw_tighten",
          "text_ar": "تم توصيل السلك."
        },
        {
          "audio": "fb/time_up.mp3",
          "sfx_before": "warning_alert",
          "text_ar": "انتهى الوقت."
        },
        {
          "audio": "fb/motor_running.mp3",
          "sfx_before": "motor_start",
          "text_ar": "اشتغل المحرك."
        },
        {
          "audio": "fb/motor_reverse.mp3",
          "sfx_before": "motor_start",
          "text_ar": "المحرك يدور في الاتجاه العكسي."
        }
      ]
    }
  ],
